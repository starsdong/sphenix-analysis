From 59f846c13eb6c8c97a53c6a4e679bd011766f178 Mon Sep 17 00:00:00 2001
From: dongxs <dongxs@bnl.gov>
Date: Sun, 8 Nov 2026 22:15:03 -0500
Subject: [PATCH 4/7] KFParticle_nTuple: pvfix_pass* flags, optional fill-time
 selection original OR refit OR KF (KFP_PVFIX_POSTCUT) (d0-pvfix fix 4)

---
 .../KFParticle_sPHENIX/KFParticle_nTuple.cc   | 60 ++++++++++++++++++-
 .../KFParticle_sPHENIX/KFParticle_nTuple.h    |  7 +++
 2 files changed, 66 insertions(+), 1 deletion(-)

diff --git a/offline/packages/KFParticle_sPHENIX/KFParticle_nTuple.cc b/offline/packages/KFParticle_sPHENIX/KFParticle_nTuple.cc
index 707ef1829..1bb5551bb 100644
--- a/offline/packages/KFParticle_sPHENIX/KFParticle_nTuple.cc
+++ b/offline/packages/KFParticle_sPHENIX/KFParticle_nTuple.cc
@@ -15,6 +15,8 @@
 #include <globalvertex/SvtxVertex.h>                // d0-pvfix fix 2
 #include <globalvertex/SvtxVertexMap.h>             // d0-pvfix fix 2
 #include <array>
+#include <cstdio>
+#include <iostream>
 #include <limits>
 #include <memory>
 #include <set>
@@ -372,6 +374,9 @@ void KFParticle_nTuple::initializeBranches(PHCompositeNode* topNode)
         bookF(dn + "_PV_DCA_sig_xy" + sfx, &q.sigxy[i]);
       }
     };
+    bookI("pvfix_passOriginal", &m_pvfix_passOriginal);
+    bookI("pvfix_passRefit", &m_pvfix_passRefit);
+    bookI("pvfix_passKF", &m_pvfix_passKF);
     bookV("primary_vertex_kf", m_v_kf);
     bookV("primary_vertex_kfAll", m_v_kfAll);
     bookQ("_PVkf", m_q_kf);
@@ -782,6 +787,7 @@ void KFParticle_nTuple::fillBranch(PHCompositeNode* topNode,
   if (m_constrain_to_vertex_nTuple && !m_use_fake_pv_nTuple)
   {
     pvRefit(topNode, motherForRefit, vertex_fillbranch, daughters);  // d0-pvfix fix 2
+    m_pvfix_keep = !m_pvfix_post || m_pvfix_passOriginal || m_pvfix_passRefit || m_pvfix_passKF;  // d0-pvfix fix 4
   }
 
   PHNodeIterator nodeIter(topNode);
@@ -829,7 +835,7 @@ void KFParticle_nTuple::fillBranch(PHCompositeNode* topNode,
     fillTriggerBranches(topNode);
   }
 
-  if (fillConditionMet())
+  if (fillConditionMet() && m_pvfix_keep)  // d0-pvfix fix 4
   {
     m_tree->Fill();
   }
@@ -1141,6 +1147,9 @@ void KFParticle_nTuple::pvRefit(PHCompositeNode* topNode, const KFParticle& moth
 {
   const float nan = std::numeric_limits<float>::quiet_NaN();
   m_nTracksOfVertex_noDaughters = -1;
+  m_pvfix_passOriginal = 1;
+  m_pvfix_passRefit = m_pvfix_passKF = 0;
+  m_pvfix_keep = true;
   for (auto* q : {&m_q_kf, &m_q_kfAll})
   {
     for (float& x : q->m)
@@ -1174,6 +1183,38 @@ void KFParticle_nTuple::pvRefit(PHCompositeNode* topNode, const KFParticle& moth
     m_da_dca[i] = m_da_dca_xy[i] = m_da_dca_sig[i] = m_da_dca_sig_xy[i] = nan;
   }
 
+  // d0-pvfix fix 4: post-selection cuts from the environment (parsed once)
+  static float s_dcaCut = -std::numeric_limits<float>::max(), s_diraCut = -std::numeric_limits<float>::max();
+  static bool s_post = [] {
+    const char* e = std::getenv("KFP_PVFIX_POSTCUT");
+    if (!e)
+    {
+      return false;
+    }
+    if (std::sscanf(e, "%f,%f", &s_dcaCut, &s_diraCut) != 2)
+    {
+      std::cout << "KFP_PVFIX_POSTCUT: cannot parse '" << e << "', post-selection off" << std::endl;
+      s_dcaCut = s_diraCut = -std::numeric_limits<float>::max();
+      return false;
+    }
+    std::cout << "KFP_PVFIX_POSTCUT: keep candidates passing |DCA| >= " << s_dcaCut << " cm and DIRA >= " << s_diraCut
+              << " with the original PV (min over PVs, as in-job) OR the pair refit OR the KF refit w/o daughters" << std::endl;
+    return true;
+  }();
+  m_pvfix_post = s_post;
+  {
+    // original selection as in KFParticle_Tools::isGoodTrack (minimum DCA over the PVs of the track's crossing) + DIRA
+    std::vector<KFParticle> allPVs = m_tools->makeAllPrimaryVertices(topNode, m_tools->get_vtx_map_node_name());
+    bool pass = m_calculated_mother_dira >= s_diraCut;
+    for (int i = 0; i < nd; ++i)
+    {
+      float dmin = 0, smin = 0;
+      m_tools->calcMinPV_DCA(daughters[i], allPVs, dmin, smin);
+      pass = pass && (dmin >= s_dcaCut);
+    }
+    m_pvfix_passOriginal = pass ? 1 : 0;
+  }
+
   auto* vmap = findNode::getClass<SvtxVertexMap>(topNode, m_tools->get_vtx_map_node_name());
   auto* tmap = findNode::getClass<SvtxTrackMap>(topNode, m_tools->get_trk_map_node_name());
   auto* sic = findNode::getClass<TrackSeedContainer>(topNode, "SiliconTrackSeedContainer");
@@ -1318,6 +1359,15 @@ void KFParticle_nTuple::pvRefit(PHCompositeNode* topNode, const KFParticle& moth
   };
   doKF(all, m_v_kfAll, m_q_kfAll);
   doKF(noD, m_v_kf, m_q_kf);
+  if (m_v_kf.status == 1)
+  {
+    bool pass = m_q_kf.m[0] >= s_diraCut;
+    for (int i = 0; i < nd; ++i)
+    {
+      pass = pass && (m_q_kf.dca[i] >= s_dcaCut);
+    }
+    m_pvfix_passKF = pass ? 1 : 0;
+  }
 
   KFParticle pv;
   const char* closure = std::getenv("KFP_PVREFIT_CLOSURE");
@@ -1352,6 +1402,14 @@ void KFParticle_nTuple::pvRefit(PHCompositeNode* topNode, const KFParticle& moth
 
   float mq[9];
   fillQ(pv, mq, m_dr_dca, m_dr_dca_xy, m_dr_dca_sig, m_dr_dca_sig_xy);
+  {
+    bool pass = mq[0] >= s_diraCut;
+    for (int i = 0; i < nd; ++i)
+    {
+      pass = pass && (m_dr_dca[i] >= s_dcaCut);
+    }
+    m_pvfix_passRefit = (m_pvr_status == 1 && pass) ? 1 : 0;
+  }
   m_mr_dira = mq[0];
   m_mr_dira_xy = mq[1];
   m_mr_fdchi2 = mq[2];
diff --git a/offline/packages/KFParticle_sPHENIX/KFParticle_nTuple.h b/offline/packages/KFParticle_sPHENIX/KFParticle_nTuple.h
index 6dcd9e016..f137f41d5 100644
--- a/offline/packages/KFParticle_sPHENIX/KFParticle_nTuple.h
+++ b/offline/packages/KFParticle_sPHENIX/KFParticle_nTuple.h
@@ -316,6 +316,13 @@ class KFParticle_nTuple : public KFParticle_truthAndDetTools, public KFParticle_
   PVfixQ m_q_kf, m_q_kfAll;
   PVfixV m_v_kf, m_v_kfAll;
 
+  // d0-pvfix fix 4: selection with the refitted PVs at fill time
+  int m_pvfix_passOriginal{1};
+  int m_pvfix_passRefit{0};
+  int m_pvfix_passKF{0};
+  bool m_pvfix_keep{true};
+  bool m_pvfix_post{false};
+
   int m_runNumber{-1};
   int m_evtNumber{-1};
   int64_t m_bco{-1};
-- 
2.52.0

