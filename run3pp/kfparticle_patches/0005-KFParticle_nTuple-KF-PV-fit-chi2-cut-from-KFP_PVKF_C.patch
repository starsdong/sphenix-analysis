From c365374ffb71fcb8003c8a61f01633a771a9606f Mon Sep 17 00:00:00 2001
From: dongxs <dongxs@bnl.gov>
Date: Sun, 8 Nov 2026 22:19:09 -0500
Subject: [PATCH 5/7] KFParticle_nTuple: KF PV fit chi2 cut from
 KFP_PVKF_CHICUT (d0-pvfix fix 3b)

---
 offline/packages/KFParticle_sPHENIX/KFParticle_nTuple.cc | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/offline/packages/KFParticle_sPHENIX/KFParticle_nTuple.cc b/offline/packages/KFParticle_sPHENIX/KFParticle_nTuple.cc
index 1bb5551bb..d40b3a122 100644
--- a/offline/packages/KFParticle_sPHENIX/KFParticle_nTuple.cc
+++ b/offline/packages/KFParticle_sPHENIX/KFParticle_nTuple.cc
@@ -1100,6 +1100,12 @@ namespace
   // d0-pvfix fix 3: KFParticle primary-vertex fit of a set of tracks; returns 1 if >= 2 tracks remain
   int pvfixKFVertex(const std::vector<PVfixTrack>& t, KFParticle& out, int& nUsed)
   {
+    static const float chiCut = [] {
+      const char* e = std::getenv("KFP_PVKF_CHICUT");
+      float v = e ? std::atof(e) : 3.5F;
+      std::cout << "d0-pvfix: KFParticle PV fit chi2-deviation cut " << v << std::endl;
+      return v;
+    }();
     nUsed = 0;
     if (t.size() < 2)
     {
@@ -1129,7 +1135,7 @@ namespace
       flag[i] = true;
     }
     KFVertex v;
-    v.ConstructPrimaryVertex(ptr.data(), (int) t.size(), flag.get(), 3.5);
+    v.ConstructPrimaryVertex(ptr.data(), (int) t.size(), flag.get(), chiCut);
     for (size_t i = 0; i < t.size(); ++i)
     {
       nUsed += flag[i] ? 1 : 0;
-- 
2.52.0

