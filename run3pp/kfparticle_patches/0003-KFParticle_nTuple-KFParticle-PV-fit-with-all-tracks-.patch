+  // d0-pvfix fix 3: KFParticle vertex fits
+  auto doKF = [&](const std::vector<PVfixTrack>& trks, PVfixV& v, PVfixQ& q) {
+    KFParticle kv;
+    v.status = pvfixKFVertex(trks, kv, v.ntrk);
+    if (v.status != 1)
+    {
