+    }
+    v.x = kv.GetX();
+    v.y = kv.GetY();
+    v.z = kv.GetZ();
+    v.chi2 = kv.GetChi2();
+    v.ndf = kv.GetNDF();
+    kv.SetId(pvIn.Id());
+    fillQ(kv, q.m, q.dca, q.dcaxy, q.sig, q.sigxy);
+  };
+  doKF(all, m_v_kfAll, m_q_kfAll);
+  doKF(noD, m_v_kf, m_q_kf);
+
   KFParticle pv;
   const char* closure = std::getenv("KFP_PVREFIT_CLOSURE");
   if (closure && std::string(closure) == "1")
