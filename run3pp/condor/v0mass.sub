# KFP Ks+Lambda without covariance cuts -> mass-vs-pT histograms only (DDSim momentum calibration)
universe       = vanilla
executable     = /gpfs02/sphenix/user/dongxs/run3pp/macro/run_v0mass.sh
arguments      = $(dst) /gpfs02/sphenix/user/dongxs/run3pp/output/v0mass_loosecov
output         = /gpfs02/sphenix/user/dongxs/run3pp/output/v0mass_loosecov/logs/condor_$Fn(dst).out
error          = /gpfs02/sphenix/user/dongxs/run3pp/output/v0mass_loosecov/logs/condor_$Fn(dst).err
log            = /tmp/dongxs/condor_logs/v0mass.log
request_memory = 3GB
getenv         = False
priority       = 10
